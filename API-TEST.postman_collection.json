{
  "info": {
    "name": "Taco Cloud Mongo API",
    "description": "Postman collection mirroring the curl smoke tests for the standalone Taco Cloud API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ingredients",
      "description": "Seed and list taco ingredients.",
      "item": [
        {
          "name": "Create Flour Tortilla",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"FLTO\",\n  \"name\": \"Flour Tortilla\",\n  \"type\": \"WRAP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ingredients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ingredients"]
            }
          }
        },
        {
          "name": "Create Ground Beef",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"GRBF\",\n  \"name\": \"Ground Beef\",\n  \"type\": \"PROTEIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ingredients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ingredients"]
            }
          }
        },
        {
          "name": "Create Cheddar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"CHED\",\n  \"name\": \"Cheddar\",\n  \"type\": \"CHEESE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ingredients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ingredients"]
            }
          }
        },
        {
          "name": "List Ingredients",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/ingredients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ingredients"]
            }
          }
        }
      ]
    },
    {
      "name": "Tacos",
      "description": "Create and fetch taco designs.",
      "item": [
        {
          "name": "Create Carnivore Taco",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carnivore\",\n  \"ingredients\": [\n    {\n      \"id\": \"FLTO\",\n      \"name\": \"Flour Tortilla\",\n      \"type\": \"WRAP\"\n    },\n    {\n      \"id\": \"GRBF\",\n      \"name\": \"Ground Beef\",\n      \"type\": \"PROTEIN\"\n    },\n    {\n      \"id\": \"CHED\",\n      \"name\": \"Cheddar\",\n      \"type\": \"CHEESE\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/design",
              "host": ["{{baseUrl}}"],
              "path": ["api", "design"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.environment.set('tacoId', json.id);",
                  "  pm.environment.set('tacoName', json.name || 'Carnivore');",
                  "}",
                  "pm.test('Created taco returns 201 status', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Recent Tacos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/design/recent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "design", "recent"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "description": "Create and fetch orders (uses tacoId set in taco create response).",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryName\": \"Craig Walls\",\n  \"deliveryStreet\": \"123 North Street\",\n  \"deliveryCity\": \"Cross Roads\",\n  \"deliveryState\": \"TX\",\n  \"deliveryZip\": \"76227\",\n  \"ccNumber\": \"4111111111111111\",\n  \"ccExpiration\": \"10/25\",\n  \"ccCVV\": \"321\",\n  \"tacos\": [\n    {\n      \"id\": \"{{tacoId}}\",\n      \"name\": \"{{tacoName}}\",\n      \"ingredients\": [\n        {\n          \"id\": \"FLTO\",\n          \"name\": \"Flour Tortilla\",\n          \"type\": \"WRAP\"\n        },\n        {\n          \"id\": \"GRBF\",\n          \"name\": \"Ground Beef\",\n          \"type\": \"PROTEIN\"\n        },\n        {\n          \"id\": \"CHED\",\n          \"name\": \"Cheddar\",\n          \"type\": \"CHEESE\"\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tacoId",
      "value": ""
    },
    {
      "key": "tacoName",
      "value": "Carnivore"
    }
  ]
}
